<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:controller="com.eyuphalitinci.calculator.CalculatorController"
      maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
      minWidth="-Infinity" prefHeight="450.0" prefWidth="300.0"
      spacing="5.0" style="-fx-background-color: #f0f0f0;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <Label fx:id="displayLabel"
           text="0"
           alignment="CENTER_RIGHT"
           maxWidth="1.7976931348623157E308"
           minHeight="60.0"
           style="-fx-padding: 10 5; -fx-text-fill: #333; -fx-font-weight: bold;"
           VBox.vgrow="NEVER">
        <font>
            <Font size="36.0"/>
        </font>
    </Label>

    <GridPane hgap="5.0" vgap="5.0" VBox.vgrow="ALWAYS">

        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        </rowConstraints>

        <children>
            <Button text="CE" onAction="#processOperator"
                    style="-fx-background-color: #d8d8d8; -fx-font-weight: bold; -fx-font-size: 18px;"
                    maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"/>
            <Button text="C" onAction="#processClear"
                    style="-fx-background-color: #d8d8d8; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="1" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"/>
            <Button text="\%" onAction="#processOperator"
                    style="-fx-background-color: #d8d8d8; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="2" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"/>
            <Button text="/" onAction="#processOperator"
                    style="-fx-background-color: #d8d8d8; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="3" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"/>

            <Button text="7" onAction="#processNumber"
                    style="-fx-background-color: white; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.rowIndex="1" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"/>
            <Button text="8" onAction="#processNumber"
                    style="-fx-background-color: white; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308"
                    maxHeight="1.7976931348623157E308"/>
            <Button text="9" onAction="#processNumber"
                    style="-fx-background-color: white; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="2" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308"
                    maxHeight="1.7976931348623157E308"/>
            <Button text="*" onAction="#processOperator"
                    style="-fx-background-color: #d8d8d8; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308"
                    maxHeight="1.7976931348623157E308"/>

            <Button text="4" onAction="#processNumber"
                    style="-fx-background-color: white; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.rowIndex="2" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"/>
            <Button text="5" onAction="#processNumber"
                    style="-fx-background-color: white; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308"
                    maxHeight="1.7976931348623157E308"/>
            <Button text="6" onAction="#processNumber"
                    style="-fx-background-color: white; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="2" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308"
                    maxHeight="1.7976931348623157E308"/>
            <Button text="-" onAction="#processOperator"
                    style="-fx-background-color: #d8d8d8; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="3" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308"
                    maxHeight="1.7976931348623157E308"/>

            <Button text="1" onAction="#processNumber"
                    style="-fx-background-color: white; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.rowIndex="3" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"/>
            <Button text="2" onAction="#processNumber"
                    style="-fx-background-color: white; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308"
                    maxHeight="1.7976931348623157E308"/>
            <Button text="3" onAction="#processNumber"
                    style="-fx-background-color: white; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="2" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308"
                    maxHeight="1.7976931348623157E308"/>
            <Button text="+" onAction="#processOperator"
                    style="-fx-background-color: #d8d8d8; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="3" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308"
                    maxHeight="1.7976931348623157E308"/>

            <Button text="0" onAction="#processNumber"
                    style="-fx-background-color: white; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.rowIndex="4" maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"/>
            <Button text="." onAction="#processNumber"
                    style="-fx-background-color: white; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="1.7976931348623157E308"
                    maxHeight="1.7976931348623157E308"/>
            <Button text="=" onAction="#processEquals"
                    style="-fx-background-color: #0078d4; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px;"
                    GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="4"
                    maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"/>

        </children>

    </GridPane>

</VBox>